{
  "$schema": "https://schema.tauri.app/config/1",
  "package": {
    "productName": "FluxShare",
    "version": "2.1.0"
  },
  "tauri": {
    "windows": [
      {
        "title": "FluxShare",
        "fullscreen": false,
        "width": 1280,
        "height": 720
      }
    ],
    "allowlist": {
      "all": false,
      "dialog": {
        "all": false,
        "open": true
      },
      "fs": {
        "all": false,
        "removeFile": true,
        "scope": [
          "**/fluxshare-archives/**",
          "**/fluxshare-transfer-temp/**"
        ]
      },
      "shell": {
        "all": false,
        "open": true
      }
    }
  },
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  }
}
